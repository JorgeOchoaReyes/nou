# Copy to .env and fill in only the providers you use. .env is gitignored.

# Pick the starting model as provider:model (or switch in the app with /model).
# NOU_MODEL=ollama:qwen3:8b
# NOU_MODEL=anthropic:claude-opus-5-5

# --- Local ---
# OLLAMA_HOST=http://127.0.0.1:11434
# Ollama context window. By default Nou asks for 32k tokens (or the model's max, if smaller),
# unless the model's Modelfile sets num_ctx. Lower it if you run out of memory.
# NOU_NUM_CTX=16384
# How much conversation (in characters, ~4 per token) Nou keeps before trimming and summarizing it.
# Defaults: 90000 for local models, 500000 for cloud ones. Lower it if a local model loses track.
# NOU_CONTEXT_CHARS=90000
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LLAMACPP_BASE_URL=http://localhost:8080/v1
# Any other OpenAI-compatible server (vLLM, Jan, LocalAI, ...):
# NOU_BASE_URL=http://localhost:8000/v1
# NOU_API_KEY=

# --- Cloud ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=

# Claude effort level: low | medium | high | xhigh | max (default high)
# NOU_EFFORT=high
